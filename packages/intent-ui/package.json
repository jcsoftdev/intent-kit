{
  "name": "@jcsoftdev/intent-ui",
  "version": "0.2.1",
  "description": "Ready-made assistant components for the intent kit on top of @jcsoftdev/ui.",
  "author": "jcsoftdev",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcsoftdev/intent-kit.git",
    "directory": "packages/intent-ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/assert-ci-publish.mjs"
  },
  "dependencies": {
    "@jcsoftdev/intent-core": "workspace:*",
    "@jcsoftdev/intent-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20",
    "@jcsoftdev/ui": ">=0.10.0 <0.11"
  },
  "devDependencies": {
    "@jcsoftdev/intent-testing": "workspace:*",
    "@jcsoftdev/intent-dom": "workspace:*",
    "@jcsoftdev/ui": "0.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
