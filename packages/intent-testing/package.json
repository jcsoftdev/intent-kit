{
  "name": "@jcsoftdev/intent-testing",
  "version": "0.0.0",
  "private": true,
  "description": "Intent kit testing package",
  "author": "jcsoftdev",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcsoftdev/intent-kit.git",
    "directory": "packages/intent-testing"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jcsoftdev/intent-core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=4.1.0 <5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jcsoftdev/intent-zod": "workspace:*",
    "zod": "4.6.7"
  }
}
