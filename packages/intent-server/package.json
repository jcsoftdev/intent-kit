{
  "name": "@jcsoftdev/intent-server",
  "version": "0.1.0",
  "description": "Server side of the intent kit: turns an utterance into a validated, tenant-scoped plan.",
  "author": "jcsoftdev",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcsoftdev/intent-kit.git",
    "directory": "packages/intent-server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/assert-ci-publish.mjs"
  },
  "dependencies": {
    "@jcsoftdev/intent-core": "workspace:*"
  },
  "devDependencies": {
    "@jcsoftdev/intent-testing": "workspace:*",
    "@jcsoftdev/intent-zod": "workspace:*",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
