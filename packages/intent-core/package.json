{
  "name": "@jcsoftdev/intent-core",
  "version": "0.2.1",
  "description": "Client core of the intent kit: capability descriptors, the action pipeline and the intent session.",
  "author": "jcsoftdev",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcsoftdev/intent-kit.git",
    "directory": "packages/intent-core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/assert-ci-publish.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
